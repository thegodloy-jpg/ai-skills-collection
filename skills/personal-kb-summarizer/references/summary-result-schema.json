{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/pkb/summary-result.schema.json",
  "title": "Personal KB SummaryResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "policy_version",
    "thread_id",
    "title",
    "primary_topic",
    "topics",
    "value",
    "archive_policy",
    "state",
    "summary",
    "decisions",
    "actions",
    "questions",
    "claims",
    "derived_from"
  ],
  "properties": {
    "format": { "const": "pkb.summary-result" },
    "schema_version": { "const": 1 },
    "policy_version": { "type": "integer", "minimum": 1 },
    "thread_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "title": { "type": "string", "minLength": 2, "maxLength": 80 },
    "primary_topic": { "type": "string", "minLength": 1, "maxLength": 80 },
    "topics": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "value": {
      "enum": ["ephemeral", "reference", "knowledge", "project"]
    },
    "archive_policy": {
      "enum": ["full", "summary_only", "local_only", "skip"]
    },
    "state": {
      "enum": ["active", "dormant", "archived"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/decision" }
    },
    "actions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/action" }
    },
    "questions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/question" }
    },
    "claims": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/claim" }
    },
    "derived_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_event_id", "event_count"],
      "properties": {
        "last_event_id": { "type": "string", "minLength": 1, "maxLength": 300 },
        "event_count": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "sourceTurns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "attribution": {
      "enum": ["user_confirmed", "assistant_proposed", "externally_verified", "unverified"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "attribution", "source_turns", "superseded_by"],
      "properties": {
        "id": { "type": "string", "pattern": "^D-[0-9]{3,}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "enum": ["active", "superseded"] },
        "attribution": { "const": "user_confirmed" },
        "source_turns": { "$ref": "#/$defs/sourceTurns" },
        "superseded_by": { "type": ["string", "null"], "pattern": "^D-[0-9]{3,}$" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "owner", "source_turns"],
      "properties": {
        "id": { "type": "string", "pattern": "^A-[0-9]{3,}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "enum": ["open", "done", "cancelled"] },
        "owner": { "enum": ["user", "assistant", "system", "unknown"] },
        "source_turns": { "$ref": "#/$defs/sourceTurns" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "source_turns"],
      "properties": {
        "id": { "type": "string", "pattern": "^Q-[0-9]{3,}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "enum": ["open", "resolved"] },
        "source_turns": { "$ref": "#/$defs/sourceTurns" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "status", "attribution", "source_turns", "superseded_by"],
      "properties": {
        "id": { "type": "string", "pattern": "^C-[0-9]{3,}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "enum": ["active", "superseded", "rejected"] },
        "attribution": { "$ref": "#/$defs/attribution" },
        "source_turns": { "$ref": "#/$defs/sourceTurns" },
        "superseded_by": { "type": ["string", "null"], "pattern": "^[CD]-[0-9]{3,}$" }
      }
    }
  }
}
